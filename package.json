{
  "name": "lingo-chrome-extension",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:security": "node tests/security.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "package:store": "python3 scripts/package-store.py",
    "test:review": "node tests/review.mjs",
    "test:features": "node tests/features.mjs",
    "package:dev": "python3 scripts/package-store.py --development"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "tsx": "^4.20.0",
    "playwright": "^1.56.0"
  },
  "license": "MIT"
}
