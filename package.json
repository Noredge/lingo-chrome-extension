{
  "name": "lingo-chrome-extension",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:security": "node tests/security.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "package:store": "python3 scripts/package-store.py",
    "test:review": "node tests/review.mjs",
    "test:features": "node tests/features.mjs",
    "test:onboarding": "node tests/onboarding.mjs",
    "test:writing-guide": "node tests/writing-guide.mjs",
    "test:comparison": "node tests/comparison.mjs",
    "test:presets": "node tests/presets.mjs",
    "test:inline": "node tests/inline.mjs",
    "test:automatic": "node tests/automatic.mjs",
    "test:hover": "node tests/hover.mjs",
    "test:rich-inline": "node tests/rich-inline.mjs",
    "test:writing-settings": "node tests/writing-settings.mjs",
    "test:dictionary": "node tests/dictionary.mjs",
    "test:lookup": "node tests/lookup.mjs",
    "test:refinement": "node tests/refinement.mjs",
    "test:shortcuts": "node tests/shortcuts.mjs",
    "test:inline-review": "node tests/inline-review.mjs",
    "test:inline-navigation": "node tests/inline-navigation.mjs",
    "test:check-readiness": "node tests/check-readiness.mjs",
    "test:inline-idle": "node tests/inline-idle.mjs",
    "test:check-latency": "node tests/check-latency.mjs",
    "test:inline-observation": "node tests/inline-observation.mjs",
    "test:editor-boundaries": "node tests/editor-boundaries.mjs",
    "test:release-smoke": "node tests/release-smoke.mjs",
    "test:ui-trust": "node tests/ui-trust.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "tsx": "^4.20.0",
    "playwright": "^1.56.0"
  },
  "license": "MIT"
}
